# ==========================================
# SimFly Pakistan Bot Environment Variables
# ==========================================

# WhatsApp Admin (Pakistan format: 923001234567)
ADMIN_JID=923001234567@s.whatsapp.net

# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxx

# Firebase Project ID
FIREBASE_PROJECT_ID=simfly-pakistan

# Product Delivery URLs (Google Drive / Direct CDN)
QR_4GB_URL=https://drive.google.com/uc?export=view&id=YOUR_4GB_QR_ID
QR_8GB_URL=https://drive.google.com/uc?export=view&id=YOUR_8GB_QR_ID
COURSES_DRIVE_URL=https://drive.google.com/uc?export=download&id=YOUR_COURSES_PDF_ID

# Optional: Custom Internet package delivery URL/Instructions
INTERNET_DELIVERY_URL=https://your-cdn.com/internet-setup.pdf
